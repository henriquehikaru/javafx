<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="920.0"
            style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.controller.MainController">

    <children>

        <VBox spacing="24.0"
              AnchorPane.leftAnchor="24.0"
              AnchorPane.rightAnchor="24.0"
              AnchorPane.topAnchor="24.0"
              AnchorPane.bottomAnchor="24.0">

            <VBox spacing="4.0">
                <children>
                    <Label text="Cadastro de Produtos"
                           style="-fx-font-family: 'Segoe UI', System;
                                  -fx-font-size: 26px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #0f172a;" />
                    <Label text="Gerencie o inventário de produtos do sistema"
                           style="-fx-font-family: 'Segoe UI', System;
                                  -fx-font-size: 14px;
                                  -fx-text-fill: #64748b;" />
                </children>
            </VBox>

            <GridPane hgap="20" vgap="16"
                      style="-fx-background-color: #ffffff;
                             -fx-padding: 24;
                             -fx-background-radius: 12;
                             -fx-border-radius: 12;
                             -fx-border-color: #e2e8f0;
                             -fx-border-width: 1;
                             -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.05), 12, 0, 0, 4);">

                <columnConstraints>
                    <ColumnConstraints prefWidth="120" minWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints minHeight="42"/>
                    <RowConstraints minHeight="42"/>
                    <RowConstraints minHeight="42"/>
                </rowConstraints>

                <Label text="Descrição"
                       style="-fx-font-family: 'Segoe UI', System; -fx-font-weight: 600; -fx-text-fill: #334155; -fx-font-size: 13px;"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                <TextField fx:id="txtDescricao"
                           promptText="Ex: Smartphone Samsung Galaxy S24"
                           style="-fx-background-color: #ffffff;
                                  -fx-background-radius: 6;
                                  -fx-border-radius: 6;
                                  -fx-border-color: #cbd5e1;
                                  -fx-border-width: 1;
                                  -fx-padding: 10 12;
                                  -fx-text-fill: #0f172a;"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Categoria"
                       style="-fx-font-family: 'Segoe UI', System; -fx-font-weight: 600; -fx-text-fill: #334155; -fx-font-size: 13px;"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                <TextField fx:id="txtCategoria"
                           promptText="Ex: Eletrônicos"
                           style="-fx-background-color: #ffffff;
                                  -fx-background-radius: 6;
                                  -fx-border-radius: 6;
                                  -fx-border-color: #cbd5e1;
                                  -fx-border-width: 1;
                                  -fx-padding: 10 12;
                                  -fx-text-fill: #0f172a;"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Preço (R$)"
                       style="-fx-font-family: 'Segoe UI', System; -fx-font-weight: 600; -fx-text-fill: #334155; -fx-font-size: 13px;"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>

                <TextField fx:id="txtPreco"
                           promptText="0,00"
                           style="-fx-background-color: #ffffff;
                                  -fx-background-radius: 6;
                                  -fx-border-radius: 6;
                                  -fx-border-color: #cbd5e1;
                                  -fx-border-width: 1;
                                  -fx-padding: 10 12;
                                  -fx-text-fill: #0f172a;"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            </GridPane>

            <HBox spacing="12" alignment="CENTER_LEFT">

                <Button fx:id="btnSalvar"
                        text="Salvar Produto"
                        onAction="#salvarProduto"
                        prefWidth="140"
                        style="-fx-background-color: #10b981;
                               -fx-text-fill: white;
                               -fx-font-family: 'Segoe UI', System;
                               -fx-font-weight: bold;
                               -fx-font-size: 13px;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;
                               -fx-padding: 10 16;" />

                <Button fx:id="btnLimpar"
                        text="Limpar Campos"
                        onAction="#limpaCampos"
                        prefWidth="140"
                        style="-fx-background-color: #f1f5f9;
                               -fx-text-fill: #475569;
                               -fx-font-family: 'Segoe UI', System;
                               -fx-font-weight: bold;
                               -fx-font-size: 13px;
                               -fx-background-radius: 6;
                               -fx-border-radius: 6;
                               -fx-border-color: #cbd5e1;
                               -fx-cursor: hand;
                               -fx-padding: 10 16;" />

                <HBox HBox.hgrow="ALWAYS" />

                <Button fx:id="btnExcluir"
                        text="Excluir"
                        onAction="#excluirProduto"
                        prefWidth="110"
                        style="-fx-background-color: #ef4444;
                               -fx-text-fill: white;
                               -fx-font-family: 'Segoe UI', System;
                               -fx-font-weight: bold;
                               -fx-font-size: 13px;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;
                               -fx-padding: 10 16;" />
            </HBox>

            <TableView fx:id="tblProdutos"
                       onMouseClicked="#carregarCampos"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #ffffff;
                              -fx-background-radius: 8;
                              -fx-border-radius: 8;
                              -fx-border-color: #e2e8f0;
                              -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.03), 8, 0, 0, 2);">

                <columns>
                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="80"
                                 style="-fx-alignment: CENTER-LEFT;" />

                    <TableColumn fx:id="colDescricao"
                                 text="Descrição"
                                 prefWidth="350" />

                    <TableColumn fx:id="colCategoria"
                                 text="Categoria"
                                 prefWidth="220" />

                    <TableColumn fx:id="colPreco"
                                 text="Preço"
                                 prefWidth="150"
                                 style="-fx-alignment: CENTER-RIGHT;" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>

            </TableView>

        </VBox>

    </children>

</AnchorPane>